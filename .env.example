# SF-LangGraph-TS - variables de entorno (solo documentacion)
# El unico fichero permitido es .env.example; nunca subir un .env real.
# En fase bootstrap ninguna variable esta en uso real.
# Politica: secretos minimos por componente, revocables, nunca en el repositorio ni en logs.

# Linear (sub-issue Linear Integration)
LINEAR_WEBHOOK_SECRET=
LINEAR_API_KEY=

# GitHub (sub-issue GitHub Integration)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Codex SDK (sub-issue Codex Agent Adapter)
OPENAI_API_KEY=
